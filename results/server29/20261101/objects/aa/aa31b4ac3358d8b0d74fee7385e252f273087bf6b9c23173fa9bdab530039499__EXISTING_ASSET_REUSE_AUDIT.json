    {
      "file_sha256": "48bd12d252c827ae57c48b2228d95e30de9f92baad47ebc2e8b64405b49e516e",
      "first_line": 126,
      "last_line": 129,
      "name": "relative_state_mse",
      "path": "/data/zypan/worktrees/hadamard-init-dense-oracle-v1-qwen/experiments/QWEN_RECURRENT_DENSE_C5_C6_V1/run_recurrent_dense.py",
      "source": "def relative_state_mse(value: torch.Tensor, reference: torch.Tensor) -> torch.Tensor:\n    numerator = (value.float() - reference.float()).square().sum(dim=(-2, -1))\n    denominator = reference.float().square().sum(dim=(-2, -1)).clamp_min(EPS)\n    return (numerator / denominator).mean()",
      "source_sha256": "cbaf614c7da6506622f56fd34759ad66ffa6c03d0f33475ca4fe61e42c3a2da0"
    },
    {
      "file_sha256": "48bd12d252c827ae57c48b2228d95e30de9f92baad47ebc2e8b64405b49e516e",
      "first_line": 332,
      "last_line": 339,
      "name": "captured_losses",
      "path": "/data/zypan/worktrees/hadamard-init-dense-oracle-v1-qwen/experiments/QWEN_RECURRENT_DENSE_C5_C6_V1/run_recurrent_dense.py",
      "source": "def captured_losses(self) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:\n        missing_state = sorted(set(GDN_LAYERS) - set(self.state_losses))\n        missing_func = sorted(set(GDN_LAYERS) - set(self.functional_losses))\n        if missing_state or missing_func:\n            raise RuntimeError(f\"capture incomplete state={missing_state} functional={missing_func}\")\n        state = sum(self.state_losses.values()) / len(GDN_LAYERS)\n        functional = sum(self.functional_losses.values()) / len(GDN_LAYERS)\n        return state, functional, state, functional + 0.1 * state",
      "source_sha256": "b7a3f534fe2784ab20bd8d5f525ea42cc51492f5dfd4cf5386950daf55cd95cd"
    },
    {
      "file_sha256": "48bd12d252c827ae57c48b2228d95e30de9f92baad47ebc2e8b64405b49e516e",
      "first_line": 153,
      "last_line": 184,
      "name": "detach_cache",
      "path": "/data/zypan/worktrees/hadamard-init-dense-oracle-v1-qwen/experiments/QWEN_RECURRENT_DENSE_C5_C6_V1/run_recurrent_dense.py",
      "source": "def detach_cache(cache) -> None:\n    if cache is None:\n        return\n    names = (\"recurrent_states\", \"conv_states\", \"keys\", \"values\", \"key_cache\", \"value_cache\")\n    for name in names:\n        if hasattr(cache, name):\n            try:\n                setattr(cache, name, detach_tree(getattr(cache, name)))\n            except (AttributeError, TypeError):\n                current = getattr(cache, name)\n                if isinstance(current, list):\n                    for index, item in enumerate(current):\n                        current[index] = detach_tree(item)\n    for layer in getattr(cache, \"layers\", []):\n        for name in names:\n            if hasattr(layer, name):\n                try:\n                    setattr(layer, name, detach_tree(getattr(layer, name)))\n                except (AttributeError, TypeError):\n                    pass\n        # record_past=True selects the differentiable concat path for the\n        # depthwise-convolution cache.  Retain only the formal kernel window at\n        # graph boundaries so numerical state continues without unbounded\n        # history growth.\n        conv_states = getattr(layer, \"conv_states\", None)\n        kernels = getattr(layer, \"conv_kernel_size\", None)\n        if isinstance(conv_states, dict) and isinstance(kernels, dict):\n            for state_idx, value in list(conv_states.items()):\n                if torch.is_tensor(value) and state_idx in kernels:\n                    conv_states[state_idx] = value.detach()[..., -int(kernels[state_idx]) :]\n        if hasattr(layer, \"record_past\"):\n            layer.record_past = True",
      "source_sha256": "25823f4a609b602278c749b7e9546d91f8322f4fa89350cbd32e8ad74ca3a9b1"
    },
    {
      "file_sha256": "62e769dfad73170279daf0bdb56855b7d7e4aaf77478de897958fa87b2608067",
      "first_line": 173,
      "last_line": 176,
      "name": "relative_mse",
      "path": "/data/zypan/worktrees/hadamard-init-dense-oracle-v1-qwen/experiments/shared/rotation/cayley_rotation.py",
      "source": "def relative_mse(value: torch.Tensor, reference: torch.Tensor, eps: float = EPS) -> torch.Tensor:\n    numerator = (value.float() - reference.float()).square().sum()\n    denominator = reference.float().square().sum().clamp_min(eps)\n    return numerator / denominator",
      "source_sha256": "43402332914d9374c1c79b2401d568ff1b8d1d476c5cb678d2cd9339ce23ca10"
    },
    {
      "file_sha256": "77b1e1f6dad8a0dd53a27cf5a47c02be86c26d2cf30732604ba6d3747e178f69",
      "first_line": 269,
      "last_line": 285,
      "name": "quantize_c128",
      "path": "/data/zypan/worktrees/hadamard-init-dense-oracle-v1-qwen/experiments/qwen_gdn/QWEN_C5_C6_AIME26_CANONICAL60_V1/scripts/run_qwen_c5_c6_formal.py",
      "source": "def quantize_c128(cache, audit):\n    for layer_idx in GDN_LAYERS:\n        state = get_state(cache, layer_idx)\n        if list(state.shape[-3:]) != [32, 128, 128]:\n            raise RuntimeError(f\"unexpected GDN state shape at layer {layer_idx}: {list(state.shape)}\")\n        source = state.detach().float()\n        scale = source.abs().amax(dim=-2, keepdim=True).clamp_min(EPS) / 127.0\n        codes = torch.round(source / scale).clamp(-127, 127)\n        dequant = codes * scale\n        if not bool(torch.isfinite(dequant).all().item()):\n            raise FloatingPointError(f\"nonfinite C128 dequant at layer {layer_idx}\")\n        state.copy_(dequant.to(state.dtype))\n        audit[\"layers\"].add(layer_idx)\n        audit[\"scale_shapes\"][str(layer_idx)] = list(scale.shape)\n        audit[\"code_min\"] = min(audit[\"code_min\"], int(codes.min().item()))\n        audit[\"code_max\"] = max(audit[\"code_max\"], int(codes.max().item()))\n    audit[\"calls\"] += 1",
      "source_sha256": "6fcbb0aab0aa9d5a324fc1b5fd36a177ba1f7ffa086c6b13f8bd8f9f9e9de82b"
    },
    {
      "file_sha256": "0f85e40100070c051a01d05125341c1863b5c9808247803a725b1b218f54412d",
      "first_line": 237,
      "last_line": 285,
      "name": "train_document",
      "path": "/data/zypan/worktrees/qwen-gdn-c6r-c7-4x3090-deployment-v1/experiments/QWEN_GDN_A800_CLEANROOM_C5R_C6R_C7_MATCHED_V1/scripts/a800_matched.py",
      "source": "def train_document(model,tokenizer,bank,patch,hook,opt,device,row,update,arm,smoke=False):\n    ids,positions=core.tokenize(tokenizer,row)\n    if smoke:\n        ids=ids[:64];positions=[63];targets=unified_teacher(model,patch,ids,positions)\n    else:\n        if len(ids)!=1024 or len(positions)!=8:raise RuntimeError('formal trace size mismatch')\n        targets=cached(row,ids,positions)\n    start=time.monotonic();torch.cuda.reset_peak_memory_stats(device);opt.zero_grad(set_to_none=True)\n    cache=None;losses=[];captures=[];boundaries=[];qbefore=patch.qdq_audit['calls']\n    for i,token in enumerate(ids):\n        capture=i in positions\n        if capture:core.install_teacher_target(patch,targets[i],device)\n        hook.active=capture\n        cache=core.forward_student(model,patch,token,cache,capture)\n        if capture:\n            state,functional,c5,c6=patch.captured_losses()\n            hidden=core.CAYLEY.relative_mse(hook.value,targets[i]['hidden'].to(device))\n            selected={'C5R':c5,'C6R':c6,'C7':hidden}[arm]\n            vals={'state':float(state.detach()),'functional':float(functional.detach()),'final_hidden':float(hidden.detach())}\n            if any(not math.isfinite(v) for v in vals.values()):raise FloatingPointError('nonfinite captured loss')\n            losses.append(selected/len(positions));captures.append(dict(position=i,optimized_loss=float(selected.detach()),**vals))\n            del state,functional,c5,c6,hidden,selected;hook.clear()\n        if (i+1)%64==0 or i+1==len(ids):\n            if losses:\n                total=sum(losses);total.backward();losses.clear();del total\n            boundaries.append({'tokens':i+1,'after_backward_allocated':torch.cuda.memory_allocated(device),'reserved':torch.cuda.memory_reserved(device)})\n            patch.clear_capture();hook.clear();core.detach_cache(cache)\n        if (i+1)%128==0:print(json.dumps({'event':'training_token','arm':arm,'update':update,'tokens':i+1}),flush=True)\n    if patch.qdq_audit['calls']-qbefore!=24*len(ids):raise RuntimeError('QDQ coverage mismatch')\n    params=list(bank.parameters())\n    if len(params)!=24 or any(p.grad is None or not bool(torch.isfinite(p.grad).all()) for p in params):raise FloatingPointError('invalid theta gradient')\n    norms={str(l):float(bank.layer(l).theta.grad.norm()) for l in core.GDN_LAYERS}\n    if sum(v>0 for v in norms.values())<2:raise RuntimeError('insufficient nonzero layer gradient')\n    before=[p.detach().clone() for p in params]\n    gradient=float(torch.nn.utils.clip_grad_norm_(params,1.0))\n    if not math.isfinite(gradient) or gradient>F.EXPLODING_GRAD_NORM:raise FloatingPointError('exploding gradient')\n    opt.step();after_step=torch.cuda.memory_allocated(device)\n    movements=[float((p.detach()-b).norm()) for p,b in zip(params,before)]\n    if not any(v>0 for v in movements):raise RuntimeError('theta did not move')\n    del cache,targets,before;M.clean(patch)\n    orth=bank.runtime_gate(threshold=core.ORTHOGONALITY_THRESHOLD)\n    if orth['status']!='PASS':raise RuntimeError('rotation orthogonality failed')\n    if any(p.requires_grad or p.grad is not None for p in model.parameters()):raise RuntimeError('base model not frozen')\n    return {'arm':arm,'update':update,'exposure':update*len(positions),'document_id':row['document_id'],\n        'captures':captures,'training_primary_loss':sum(c[PRIMARY[arm]] for c in captures)/len(positions),\n        'training_optimized_loss':sum(c['optimized_loss'] for c in captures)/len(positions),\n        'gradient_norm':gradient,'per_layer_gradient_norm':norms,'theta_movement':movements,'orthogonality':orth,\n        'boundaries':boundaries,'after_optimizer_allocated':after_step,'memory':F.memory_snapshot(device,'post_update_cleanup'),\n        'runtime_seconds':time.monotonic()-start,'QDQ_calls':24*len(ids),'H':64,'numerical_state_reset_at_boundaries':False}",
      "source_sha256": "0f79b5ced1625b7f543180fa3f41f9087e8f308f3d84a87283d5ef78dc5161d5"
    }
  ],
  "original_teacher_capture_source": "def collect_teacher_targets(model, patch, ids: list[int], positions: list[int]) -> dict[int, dict[str, dict[int, torch.Tensor]]]:\n    \"\"\"Reproduce the old trace collector's chunk-to-position teacher path.\"\"\"\n    targets = {}\n    cache = None\n    current = 0\n    for position in positions:\n        if current < position:\n            cache = forward_teacher(model, patch, ids[current:position], cache, False)\n        patch.clear_capture()\n        cache = forward_teacher(model, patch, [ids[position]], cache, True)\n        missing_state = sorted(set(GDN_LAYERS) - set(patch.teacher_prev))\n        missing_out = sorted(set(GDN_LAYERS) - set(patch.teacher_out))\n        if missing_state or missing_out:\n            raise RuntimeError(f\"teacher capture incomplete state={missing_state} out={missing_out}\")\n        targets[position] = {\n            \"prev\": {layer: value.detach().cpu() for layer, value in patch.teacher_prev.items()},\n            \"out\": {layer: value.detach().cpu() for layer, value in patch.teacher_out.items()},\n        }\n        current = position + 1\n    del cache\n    patch.clear_capture()\n    return targets",
  "rotations": {
    "ANCHOR_CONDITION_COUNT": 4,
    "ANCHOR_IDENTITY_GATE": "PASS",
    "anchors": [
      {
